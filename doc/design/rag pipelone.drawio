        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n    subgraph A[\&quot;A. PHA NẠP — Parser Agent (ngoại tuyến, 15–30 phút cho 5 tài liệu)\&quot;]\n        direction TB\n        in1[/\&quot;Tệp tải lên\&quot;/] --&gt; a1\n        a1[\&quot;&lt;b&gt;A1 · Phân tích&lt;/b&gt;&lt;br/&gt;pymupdf4llm → markdown theo trang&lt;br/&gt;pdfplumber → bảng, toạ độ từ\&quot;] --&gt; a2\n        a2{\&quot;&lt;b&gt;A2 · Cổng chất lượng&lt;/b&gt;&lt;br/&gt;mật độ chữ · tỉ lệ dấu tiếng Việt\&quot;}\n        a2 --&gt;|\&quot;đạt\&quot;| a3\n        a2 --&gt;|\&quot;không đạt\&quot;| rej[\&quot;Từ chối ảnh quét&lt;br/&gt;+ thông báo UI\&quot;]\n        a3[\&quot;&lt;b&gt;A3 · Chia đoạn theo cấu trúc&lt;/b&gt;&lt;br/&gt;Điều → Khoản → Điểm&lt;br/&gt;cha–con · bảng tách riêng\&quot;] --&gt; a4\n        a4[\&quot;&lt;b&gt;A4 · Làm giàu đoạn&lt;/b&gt;&lt;br/&gt;tiêu đề ngữ cảnh · siêu dữ liệu regex&lt;br/&gt;hồ sơ tài liệu + tóm tắt (4b)\&quot;] --&gt; a5\n        a5[\&quot;&lt;b&gt;A5 · Sinh vector&lt;/b&gt;&lt;br/&gt;dense: bge-m3 qua Ollama&lt;br/&gt;sparse: BM25, tách âm tiết tiếng Việt\&quot;] --&gt;|\&quot;upsert\&quot;| qd\n        qd[(\&quot;&lt;b&gt;Qdrant&lt;/b&gt; vtagent_docs&lt;br/&gt;dense 1024 · sparse IDF&lt;br/&gt;payload: doc, trang, bbox,&lt;br/&gt;điều khoản, parent_id\&quot;)]\n    end\n\n    subgraph B[\&quot;B. PHA TRUY VẤN — Coordinator → Retriever → Reasoner (~80 giây mỗi truy vấn)\&quot;]\n        direction TB\n        ask[/\&quot;Câu hỏi\&quot;/] --&gt; b1\n        b1[\&quot;&lt;b&gt;B1 · Hiểu truy vấn&lt;/b&gt;&lt;br/&gt;viết lại · doc_filter · ý định (4b)\&quot;] --&gt; b2\n        qb[(\&quot;Qdrant&lt;br/&gt;vtagent_docs\&quot;)] -.-&gt;|\&quot;query_points\&quot;| b2\n        b2[\&quot;&lt;b&gt;B2 · Truy xuất lai&lt;/b&gt;&lt;br/&gt;dense top-40 ‖ sparse top-40 → RRF\&quot;] --&gt; b3\n        b3[\&quot;&lt;b&gt;B3 · Xếp hạng lại&lt;/b&gt;&lt;br/&gt;cross-encoder · 40 → 5 · lọc ngưỡng\&quot;] --&gt; b4\n        b4[\&quot;&lt;b&gt;B4 · Lắp ghép ngữ cảnh&lt;/b&gt;&lt;br/&gt;con → cha · khử trùng · ≤ 2500 token&lt;br/&gt;gắn nhãn [S1]…[S5]\&quot;] --&gt; b5\n        b5[\&quot;&lt;b&gt;B5 · Sinh câu trả lời&lt;/b&gt;&lt;br/&gt;qwen3.5:9b · mỗi ý kèm [S#]\&quot;] --&gt; b6\n        b6[\&quot;&lt;b&gt;B6 · Kiểm chứng&lt;/b&gt;&lt;br/&gt;tách ý → đối chiếu bằng chứng (4b)\&quot;] --&gt; b7\n        b6 -.-&gt;|\&quot;thiếu bằng chứng → gap_queries, tối đa 1 lần\&quot;| b2\n        b7[\&quot;&lt;b&gt;B7 · Ánh xạ trích dẫn&lt;/b&gt;&lt;br/&gt;[S#] → tệp · trang · bbox\&quot;] --&gt; out\n        out[/\&quot;Câu trả lời + trích dẫn\&quot;/]\n    end\n\n    classDef gate fill:#FFF8E1,stroke:#BF9000\n    classDef bad fill:#FDE9E7,stroke:#C0504D\n    classDef llm fill:#E2EFDA,stroke:#548235,stroke-width:1.5px\n    classDef start fill:#DCE6F1,stroke:#1F3864,stroke-width:1.5px\n    class a2 gate\n    class rej bad\n    class b5 llm\n    class b1 start&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="hgNDmkmLf6EF_3c0F3qO-1">
