        </mxCell>
        <mxCell id="t42" value="Mọi bảng gốc (documents, conversations, review_rules, ingest_jobs) mang tenant_id → tenants;&lt;br&gt;chỉ vẽ một đường để sơ đồ dễ đọc. Đường nét đứt: không có khóa ngoại thật, ứng dụng tự giữ nhất quán.&lt;br&gt;Thực thể Tệp gốc (1 – 1 với Phiên bản) được gộp vào bảng document_versions." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5B6B7B;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="640" width="1000" height="60" as="geometry" />
        </mxCell>
