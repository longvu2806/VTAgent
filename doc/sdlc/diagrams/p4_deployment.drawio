        <mxCell id="s1" value="&lt;b&gt;API × N&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;xác thực, RBAC&lt;/font&gt;" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#7F8C9B;fontColor=#1A1A1A;fontSize=12;align=center;spacingLeft=6;dashed=1;rounded=1;arcSize=22;" vertex="1" parent="srv">
