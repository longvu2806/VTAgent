          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5B6B7B;strokeWidth=1.5;exitX=0.7632;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;startArrow=block;startFill=1;" edge="1" parent="1" source="app" target="qd">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5B6B7B;strokeWidth=1.5;exitX=0.0526;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;startArrow=block;startFill=1;" edge="1" parent="1" source="app" target="data">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="330" y="330" />
              <mxPoint x="160" y="330" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="t0" value="HTTP, SSE" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5B6B7B;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="252" y="80" width="50" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t1" value="Mọi dịch vụ chỉ lắng nghe 127.0.0.1; không có kết nối ra ngoài khi vận hành (NFR-01).&lt;br&gt;Mô hình, ảnh Docker và gói Python chỉ được tải một lần lúc cài đặt.&lt;br&gt;Một lệnh cài đặt (NFR-14): kiểm tra Ollama, kéo mô hình, tạo môi trường Python,&lt;br&gt;tải reranker ONNX, khởi động Qdrant, đặt biến môi trường." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5B6B7B;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="490" width="840" height="110" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="Thay SQLite bằng PostgreSQL, Ollama bằng máy phục vụ có&lt;br&gt;batching trên GPU rời; thêm xác thực và phân quyền.&lt;br&gt;Kiến trúc phân tầng, đồ thị tác tử và lược đồ Qdrant&lt;br&gt;giữ nguyên nhờ tenant_id có sẵn (NFR-16)." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#5B6B7B;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="960" y="440" width="440" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
