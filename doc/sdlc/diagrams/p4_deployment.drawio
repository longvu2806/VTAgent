        <mxCell id="a0" value="&lt;b&gt;FastAPI&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;API, tệp tĩnh giao diện&lt;/font&gt;" style="html=1;whiteSpace=wrap;fillColor=#DCE6F1;strokeColor=#1F3864;fontColor=#1A1A1A;fontSize=12;align=center;spacingLeft=6;rounded=1;arcSize=22;" vertex="1" parent="app">
