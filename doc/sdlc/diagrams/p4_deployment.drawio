        <mxCell id="s4" value="&lt;b&gt;vLLM / llama-server&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;GPU rời&lt;/font&gt;" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#7F8C9B;fontColor=#1A1A1A;fontSize=12;align=center;spacingLeft=6;dashed=1;rounded=1;arcSize=22;" vertex="1" parent="srv">
          <mxGeometry x="20" y="290" width="210" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="&lt;b&gt;LDAP/AD hoặc&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;tài khoản cục bộ&lt;/font&gt;" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#7F8C9B;fontColor=#1A1A1A;fontSize=12;align=center;spacingLeft=6;dashed=1;rounded=1;arcSize=22;" vertex="1" parent="srv">
