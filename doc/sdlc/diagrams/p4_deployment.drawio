        <mxCell id="srv" value="&lt;b&gt;Mở rộng sau: server nội bộ nhiều tenant (SRS Phụ lục A)&lt;/b&gt;" style="html=1;whiteSpace=wrap;fillColor=#F5F9FC;strokeColor=#2C5F8A;fontColor=#1A1A1A;fontSize=13;align=center;spacingLeft=6;rounded=1;arcSize=2;verticalAlign=top;container=1;collapsible=0;strokeWidth=1.5;" vertex="1" parent="1">
