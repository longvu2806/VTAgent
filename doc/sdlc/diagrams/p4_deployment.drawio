        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Row-Level Security&lt;/font&gt;" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#7F8C9B;fontColor=#1A1A1A;fontSize=12;align=center;spacingLeft=6;dashed=1;rounded=1;arcSize=22;" vertex="1" parent="srv">
