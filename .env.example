# Every setting in config.py with its default. Copy to .env and uncomment to override.

# Storage
# VTAGENT_DATA_DIR=data
# Unset: embedded Qdrant under data/qdrant. Set to use a Qdrant server, e.g. http://127.0.0.1:6333
# VTAGENT_QDRANT_URL=
# VTAGENT_COLLECTION=vtagent_docs_r0

# Models served by Ollama
# VTAGENT_OLLAMA_BASE_URL=http://127.0.0.1:11434
# VTAGENT_LLM_MODEL=qwen3.5:9b
# VTAGENT_LLM_NUM_CTX=8192
# VTAGENT_LLM_TEMPERATURE=0.0
# VTAGENT_LLM_TIMEOUT_S=300
# Answer prompt: v1 (original) or v2 (rules from the R4 error analysis), see core/prompting.py
# VTAGENT_PROMPT=v2
# VTAGENT_EMBEDDING_MODEL=bge-m3
# VTAGENT_TOKENIZER_NAME=BAAI/bge-m3

# Chunking. fixed = R0 (chunk size / overlap); structured = R1 parent–child (child / parent sizes, budget).
# R1 preset: VTAGENT_CHUNKING=structured and VTAGENT_COLLECTION=vtagent_docs_r1
# VTAGENT_CHUNKING=fixed
# VTAGENT_CHUNK_SIZE=400
# VTAGENT_CHUNK_OVERLAP=50
# VTAGENT_CHILD_MIN_TOKENS=80
# VTAGENT_CHILD_MAX_TOKENS=400
# VTAGENT_PARENT_MAX_TOKENS=1200
# VTAGENT_CONTEXT_BUDGET_TOKENS=2500

# Retrieval. Hybrid search (dense + sparse, RRF) needs a collection built for its sparse type:
#   R3  (BM25):   VTAGENT_SPARSE=bm25   and VTAGENT_COLLECTION=vtagent_docs_r3
#   R3′ (bge-m3): VTAGENT_SPARSE=bge-m3 and VTAGENT_COLLECTION=vtagent_docs_r3b
#   R4: add VTAGENT_RERANK=true; reranking runs at question time, so it reuses the R3 collection
# VTAGENT_TOP_K=5
# VTAGENT_SPARSE=none
# VTAGENT_NORMALIZE_NUMBERS=false
# VTAGENT_BGE_M3_PRECISION=int8
# VTAGENT_RERANK=false
# VTAGENT_RERANKER_REPO=onnx-community/bge-reranker-v2-m3-ONNX
# VTAGENT_RERANKER_FILE=onnx/model_int8.onnx
# Unset: always keep top_k chunks. Set (0–1) after calibrating on the eval sets
# VTAGENT_RERANK_THRESHOLD=

# LLM judge for the eval's RAGAS metrics (any OpenAI-compatible API). Model: tests/eval/score.toml
# DeepSeek: https://api.deepseek.com   OpenRouter: https://openrouter.ai/api/v1 (default)
# VTAGENT_JUDGE_BASE_URL=https://openrouter.ai/api/v1
# API key of that provider. Secret: never commit it.
# VTAGENT_JUDGE_API_KEY=
