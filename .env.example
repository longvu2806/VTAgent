# Every setting in config.py with its default. Copy to .env and uncomment to override.

# Storage
# VTAGENT_DATA_DIR=data
# Unset: embedded Qdrant under data/qdrant. Set to use a Qdrant server, e.g. http://127.0.0.1:6333
# VTAGENT_QDRANT_URL=
# VTAGENT_COLLECTION=vtagent_docs_r0

# Models served by Ollama
# VTAGENT_OLLAMA_BASE_URL=http://127.0.0.1:11434
# VTAGENT_LLM_MODEL=qwen3.5:9b
# VTAGENT_LLM_NUM_CTX=8192
# VTAGENT_LLM_TEMPERATURE=0.0
# VTAGENT_LLM_TIMEOUT_S=300
# VTAGENT_EMBEDDING_MODEL=bge-m3
# VTAGENT_TOKENIZER_NAME=BAAI/bge-m3

# R0 baseline
# VTAGENT_CHUNK_SIZE=400
# VTAGENT_CHUNK_OVERLAP=50
# VTAGENT_TOP_K=5

# LLM judge for the eval's RAGAS metrics (any OpenAI-compatible API). Model: tests/eval/score.toml
# DeepSeek: https://api.deepseek.com   OpenRouter: https://openrouter.ai/api/v1 (default)
# VTAGENT_JUDGE_BASE_URL=https://openrouter.ai/api/v1
# API key of that provider. Secret: never commit it.
# VTAGENT_JUDGE_API_KEY=
